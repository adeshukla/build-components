    {
      "name": "design-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const fs=require(\"fs\"),p=require(\"path\");const root=p.resolve(\"scratchpad\");const T={\".html\":\"text/html; charset=utf-8\",\".webm\":\"video/webm\",\".json\":\"application/json\",\".png\":\"image/png\"};require(\"http\").createServer((q,s)=>{let u=decodeURIComponent(q.url.split(\"?\")[0]);if(u===\"/\")u=\"/design-directions.html\";const f=p.resolve(root,\".\"+u);if(!f.startsWith(root)){s.writeHead(403);return s.end()}fs.readFile(f,(e,b)=>{s.writeHead(e?404:200,{\"content-type\":T[p.extname(f)]||\"application/octet-stream\"});s.end(e?\"not found\":b)})}).listen(3401)"
      ],
      "port": 3401
    }
  ]
